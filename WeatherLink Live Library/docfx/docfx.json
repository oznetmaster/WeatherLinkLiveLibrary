{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "WeatherLink Live Library.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "properties": {
        "TargetFramework": "net472",
        "GenerateApiDocumentation": "false"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml"
        ]
      },
      {
        "files": [
          "articles/**.md"
        ]
      },
      {
        "files": [
          "references/**.md"
        ]
      },
      {
        "files": [
          "index.md"
        ]
      },
      {
        "files": [
          "toc.yml"
        ]
      },
      {
        "files": [
          "toc.yml",
          "guides/**.md",
          "guides/**/toc.yml",
          "reference/**.md",
          "reference/**/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "files": [
          "styles/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "WeatherLinkLiveLibrary",
      "_appName": "WeatherLinkLiveLibrary",
      "_appFooter": "Copyright (c) 2026 Neil Colvin.",
      "_enableSearch": true
    },
    "template": [
      "default",
      "modern"
    ],
    "dest": "../../docfx-site"
  }
}
