<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <AssemblyName>JsonBenchmark.Resident</AssemblyName>
    <RootNamespace>CrestronHomeNUnit.Driver</RootNamespace>
    <Version>1.0.0</Version>
    <ProcessorExpectedTestCount>1</ProcessorExpectedTestCount>
    <DeployAfterBuild>false</DeployAfterBuild>
  </PropertyGroup>
  <Import Project="$(ProcessorTestSdkRoot)\ProcessorTestPackage\ProcessorTestPackage.props" Condition="Exists('$(ProcessorTestSdkRoot)\ProcessorTestPackage\ProcessorTestPackage.props')" />
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <ManifestUtilExe Condition="'$(ManifestUtilExe)' == ''">$(NuGetPackageRoot)crestron.devicedrivers.manifestutil\29.0.10\tools\net8.0\any\ManifestUtil.exe</ManifestUtilExe>
    <LocalCrestronSdkLibDir Condition="'$(LocalCrestronSdkLibDir)' == ''">$(NuGetPackageRoot)crestron.devicedrivers.manifestutil\29.0.10\tools\net8.0\any</LocalCrestronSdkLibDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\ResidentComparison.cs" Link="ResidentComparison.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />

    <PackageDownload Include="Crestron.DeviceDrivers.ManifestUtil" Version="[29.0.10]" />
  </ItemGroup>
  <Import Project="$(ProcessorTestSdkRoot)\ProcessorTestPackage\ProcessorTestPackage.targets" Condition="Exists('$(ProcessorTestSdkRoot)\ProcessorTestPackage\ProcessorTestPackage.targets')" />
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Target Name="RequireProcessorTestSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ProcessorTestSdkRoot)\ProcessorTestPackage\ProcessorTestPackage.targets')" Text="Set ProcessorTestSdkRoot to a CrestronHomeNUnit checkout containing ProcessorTestPackage." />
  </Target>

  <Target Name="UseResidentNewtonsoft" BeforeTargets="MergeDependencies">
    <ItemGroup><ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Newtonsoft.Json'" /></ItemGroup>
  </Target>
  <ItemGroup>
    <ProcessorTestData Include="..\..\..\..\LICENSE" TargetPath="Licenses\JsonDeserialization\LICENSE" />
    <ProcessorTestData Include="$(ProcessorTestSdkRoot)\CrestronHomeNUnit.Driver\IncludeInPkg\**\*" TargetPath="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
